length>0&&<div className="operator-detail-group"><p className="operator-detail-label">{language==='fr'?'Réseaux sociaux':'Social links'}</p><div className="operator-links operator-socials">{m.links.map(link=><a className="social-link" href={link.url} key={link.label} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div></div>}</div></article>)}</div></section>

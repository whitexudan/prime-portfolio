# Generate a scrypt hash: npm run hash-password
ADMIN_PASSWORD_HASH=
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Required in production. Your actual public HTTPS origin (no trailing slash).
SITE_URL=http://localhost:3000
# Persistent directory on one Node server, NOT ephemeral/serverless storage.
DATA_DIR=./var
